<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Color x:Key="BgColor">#000000</Color>
    <Color x:Key="FgColor">#F0F0F0</Color>
    <Color x:Key="GreenColor">#00FF66</Color>
    <Color x:Key="RedColor">#FF2244</Color>
    <Color x:Key="YellowColor">#FFCC00</Color>

    <SolidColorBrush x:Key="BgBrush" Color="{StaticResource BgColor}" />
    <SolidColorBrush x:Key="FgBrush" Color="{StaticResource FgColor}" />
    <SolidColorBrush x:Key="GreenBrush" Color="{StaticResource GreenColor}" />
    <SolidColorBrush x:Key="RedBrush" Color="{StaticResource RedColor}" />
    <SolidColorBrush x:Key="YellowBrush" Color="{StaticResource YellowColor}" />

    <FontFamily x:Key="PixelFont">pack://application:,,,/Assets/#Press Start 2P, Consolas</FontFamily>

    <Style TargetType="Window">
        <Setter Property="Background" Value="{StaticResource BgBrush}" />
        <Setter Property="Foreground" Value="{StaticResource FgBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource PixelFont}" />
        <Setter Property="FontSize" Value="10" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
    </Style>

    <Style TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource FgBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource PixelFont}" />
        <Setter Property="FontSize" Value="10" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource FgBrush}" />
        <Setter Property="Background" Value="{StaticResource BgBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource PixelFont}" />
        <Setter Property="FontSize" Value="10" />
        <Setter Property="Padding" Value="8,5" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root" BorderBrush="{StaticResource FgBrush}" BorderThickness="2" CornerRadius="0"
                            Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                        <ContentPresenter x:Name="Content" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{StaticResource FgBrush}" />
                            <Setter Property="Foreground" Value="{StaticResource BgBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ToggleButton">
        <Setter Property="Foreground" Value="{StaticResource FgBrush}" />
        <Setter Property="Background" Value="{StaticResource BgBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource PixelFont}" />
        <Setter Property="FontSize" Value="10" />
        <Setter Property="Padding" Value="8,5" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Root" BorderBrush="{StaticResource FgBrush}" BorderThickness="2" CornerRadius="0"
                            Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{StaticResource GreenBrush}" />
                            <Setter Property="Foreground" Value="{StaticResource BgBrush}" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{StaticResource FgBrush}" />
                            <Setter Property="Foreground" Value="{StaticResource BgBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
